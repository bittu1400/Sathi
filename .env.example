# Copy to .env.local and fill in. Never commit real values (this repo is public).
# Server-only keys must never be imported from client code.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server only: payment routes, seed script

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SOS_SMS_NUMBER=           # E.164 team number for the demo (ends up in the client bundle)
NEXT_PUBLIC_DEMO=1                    # demo login buttons, /demo, mock checkout

ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=                     # eSewa test key (team docs, SPEC 7.7); server only
ESEWA_FORM_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_STATUS_URL=https://rc.esewa.com.np/api/epay/transaction/status/

ANTHROPIC_API_KEY=                    # P2 assistant only (paid); leave empty
